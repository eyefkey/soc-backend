# Copy to .env and adjust for your environment.
# Host is `localhost` for local dev; `postgres` when running via docker-compose.
DATABASE_URL="postgresql://soc:password@localhost:5432/soc?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Signing key for access tokens. Required — the app refuses to start without
# it rather than falling back to a default anyone could forge tokens with.
# Generate a fresh one per environment:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-generated-secret
JWT_EXPIRES_IN=1h
