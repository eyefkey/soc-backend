// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// MITRE ATT&CK enterprise tactics, used to label how an alert or incident
/// fits an intrusion so the console can group and chart by stage.
enum MitreTactic {
  RECONNAISSANCE
  RESOURCE_DEVELOPMENT
  INITIAL_ACCESS
  EXECUTION
  PERSISTENCE
  PRIVILEGE_ESCALATION
  DEFENSE_EVASION
  CREDENTIAL_ACCESS
  DISCOVERY
  LATERAL_MOVEMENT
  COLLECTION
  COMMAND_AND_CONTROL
  EXFILTRATION
  IMPACT
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

enum AssetType {
  SERVER
  DATABASE
  API
  ENDPOINT
  NETWORK_DEVICE
  CLOUD
  OTHER
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  COMPROMISED
  QUARANTINED
  DECOMMISSIONED
}

enum EvidenceType {
  IP_ADDRESS
  DOMAIN
  URL
  FILE_HASH
  LOG
  SCREENSHOT
  FILE
  OTHER
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  ATTACHED
  DETACHED
  VIEWED
  UPLOADED
  DOWNLOADED
  STATUS_CHANGED
}

enum AuditEntity {
  INCIDENT
  ALERT
  ASSET
  EVIDENCE
  INVESTIGATION
  FINDING
  USER
}

enum InvestigationStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

enum FindingConfidence {
  LOW
  MEDIUM
  HIGH
}

model Finding {
  id String @id @default(cuid())

  title       String
  description String

  confidence FindingConfidence @default(MEDIUM)

  impact         String?
  recommendation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
}

model Incident {
  id String @id @default(cuid())

  /// Sequential, human-readable reference. Analysts say "INC-4821" out
  /// loud during a handover; nobody reads a cuid to a colleague.
  number Int @unique @default(autoincrement())

  title       String
  description String?
  severity    Severity
  status      IncidentStatus @default(OPEN)

  /// Dominant ATT&CK tactic for the incident as a whole.
  tactic MitreTactic?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts        Alert[]
  evidence      Evidence[]
  assets        IncidentAsset[]
  investigation Investigation?

  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@index([tactic])
}

model Alert {
  id          String   @id @default(cuid())
  title       String
  description String?
  severity    Severity

  source   String?
  sourceIp String?
  targetIp String?

  /// Which ATT&CK stage the detection maps to.
  tactic MitreTactic?

  /// Account the activity was observed under, where the source reports
  /// one — a service account name is often the first real lead.
  affectedUser String?

  createdAt DateTime @default(now())

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id])

  @@index([incidentId])
  @@index([severity])
  @@index([createdAt])
  @@index([tactic])
}

model Evidence {
  id          String       @id @default(cuid())
  type        EvidenceType
  value       String
  description String?

  createdAt DateTime @default(now())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([type])
}

model Asset {
  id          String      @id @default(cuid())
  name        String
  type        AssetType
  status      AssetStatus @default(ACTIVE)
  hostname    String?
  ipAddress   String?
  description String?

  /*
   * Set to opt an asset into the uptime checker: it polls every asset
   * with a non-null monitoredUrl instead of reading a separate, easy-to-
   * forget target list out of the checker's own config.
   */
  monitoredUrl String?

  /*
   * Per-asset overrides for the uptime checker's default behaviour — a
   * staging site and a customer-facing API shouldn't necessarily page the
   * same way. Null means "use the checker's own default".
   */
  checkThreshold Int?
  checkSeverity  Severity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents IncidentAsset[]
}

model IncidentAsset {
  incidentId String
  assetId    String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([incidentId, assetId])
  @@index([assetId])
}

model AuditLog {
  id String @id @default(cuid())

  action AuditAction
  entity AuditEntity

  entityId String?

  userId   String?
  username String?

  description String?

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Investigation {
  id String @id @default(cuid())

  incidentId String   @unique
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  status InvestigationStatus @default(OPEN)

  assignedTo String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  conclusion String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  findings  Finding[]
}

enum UserRole {
  ADMIN
  ANALYST
  VIEWER
}

model User {
  id String @id @default(cuid())

  email    String @unique
  username String @unique

  passwordHash String

  role     UserRole @default(VIEWER)
  isActive Boolean  @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}
